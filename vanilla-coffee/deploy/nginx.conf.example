# Copie para /etc/nginx/sites-available/vanilla-coffee na VPS, ajuste server_name,
# depois: sudo ln -s /etc/nginx/sites-available/vanilla-coffee /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx
#
# Depois disso, rode o certbot (ver README) para HTTPS — ele reescreve este arquivo
# automaticamente adicionando os blocos de SSL.

server {
    listen 80;
    listen [::]:80;
    server_name SEU_DOMINIO.com.br www.SEU_DOMINIO.com.br;

    # upload de logo aceita até 5MB (ver app/api/upload/route.ts) — deixa uma margem
    client_max_body_size 6M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
