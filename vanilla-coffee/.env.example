DATABASE_URL="file:./prisma/dev.db"

# Sessão do painel administrativo — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Login único do lojista.
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# IMPORTANTE: escape todo "$" do hash como "\$" — o carregador de .env do
# Next.js faz expansão de variáveis no estilo shell ($VAR) e corrompe hashes
# bcrypt (que começam com $2b$...) se os "$" não forem escapados.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
